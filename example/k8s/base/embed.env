# Embedding settings shared by the embedder, the MCP server, the index worker and migrations.
# For another endpoint, change the URL, MODEL and DIM, and put its key in .env (RAGNAR_EMBEDDING_API_KEY).
RAGNAR__EMBEDDING__URL=http://ragnar-embedder:8000/v1
RAGNAR__EMBEDDING__MODEL=jinaai/jina-embeddings-v2-base-code
RAGNAR__EMBEDDING__DIM=768
RAGNAR_EMBED_MAX_TOKENS=512
