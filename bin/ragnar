#!/usr/bin/env bash
# Runs the Ragnar CLI bundled with the plugin. Claude Code adds this folder to the Bash tool's PATH.
# The environment lives outside the plugin folder, because that folder changes on every update.
set -euo pipefail
command -v uv >/dev/null || { echo "ragnar: uv is required: https://docs.astral.sh/uv/getting-started/installation/" >&2; exit 127; }
root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export UV_PROJECT_ENVIRONMENT="${RAGNAR_VENV:-${XDG_CACHE_HOME:-$HOME/.cache}/ragnar/venv}"
exec uv run --quiet --frozen --no-dev --project "$root" ragnar "$@"
